# Токен ZenMoney API. Получить: https://zerro.app/token
ZENMONEY_TOKEN=

# Путь к SQLite. В контейнере не менять (/data — volume); без Docker укажите свой, например ./zm.db.
# ZENMONEY_DB=/data/zm.db

# Часовой пояс для «сегодня» и периодов по умолчанию. По умолчанию Europe/Moscow.
# TZ=Europe/Moscow
